{
  "framework": "vite",
  "buildCommand": "node -e \"if (require('fs').existsSync('frontend')) process.chdir('frontend'); require('child_process').execSync('npm run build', {stdio: 'inherit'});\"",
  "installCommand": "node -e \"if (require('fs').existsSync('frontend')) process.chdir('frontend'); require('child_process').execSync('npm install', {stdio: 'inherit'});\"",
  "outputDirectory": "dist"
}
